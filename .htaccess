DirectoryIndex index.html

RewriteEngine On

# Tracking scripts: never serve a stale consent/analytics bundle.
<IfModule mod_headers.c>
  <Files "privacy-consent.js">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </Files>
</IfModule>

# Disattivazione temporanea pagina Attrezzature
RewriteRule ^attrezzature/?$ / [R=302,L]

# Redirect index.html alla home pulita
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect qualsiasi .html alla versione senza estensione
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# Serve automaticamente il file .html quando l'URL pulito esiste
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]