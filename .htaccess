DirectoryIndex index.html

RewriteEngine On

# Disattivazione temporanea pagina Attrezzature
RewriteRule ^attrezzature/?$ / [R=302,L]

# Redirect index.html alla home pulita
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^index\.html$ / [R=301,L]

# Redirect qualsiasi .html alla versione senza estensione
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^(.+?)\.html$ /$1 [R=301,L]

# Serve automaticamente il file .html quando l'URL pulito esiste
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]
